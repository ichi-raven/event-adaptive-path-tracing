{
  "version": 4,
  "configurations": [
    {
      "name": "Windows",
      "includePath": ["${workspaceFolder}/**"],
      "browse": {
        "limitSymbolsToIncludedHeaders": true,
        "databaseFilename": ""
      },
      "defines": [],
      "compilerPath": "cl.exe",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64",
      "configurationProvider": "ms-vscode.cmake-tools"
    },
    {
      "name": "MacOS",
      "includePath": ["${workspaceFolder}/**"],
      "browse": {
        "limitSymbolsToIncludedHeaders": true,
        "databaseFilename": ""
      },
      "defines": ["VULKAN_SDK=$HOME/VulkanSDK/1.4/macOS"],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c11",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64",
      "configurationProvider": "ms-vscode.cmake-tools"
    },
    {
      "name": "Linux",
      "includePath": ["${workspaceFolder}/**"],
      "browse": {
        "limitSymbolsToIncludedHeaders": true,
        "databaseFilename": ""
      },
      "defines": [],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c11",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",
      "configurationProvider": "ms-vscode.cmake-tools"
    }
  ]
}
